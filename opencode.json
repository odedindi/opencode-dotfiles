{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "autoupdate": "notify",
  "plugin": [
    "oh-my-openagent@latest"
  ],
  "permission": {
    "read": {
      "*": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.ssh/**": "deny"
    },
    "edit": {
      "*": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.ssh/**": "deny"
    },
    "write": {
      "*": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.ssh/**": "deny"
    }
  }
}
