{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "autoupdate": "notify",
  "plugin": [
    "oh-my-openagent@latest",
    "opencode-copilot-auth@latest"
  ],
  "permission": {
    "read": {
      "*": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.ssh/**": "deny"
    },
    "edit": {
      "*": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.ssh/**": "deny"
    },
    "write": {
      "*": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.ssh/**": "deny"
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://ollama.com"
      },
      "models": {
      }
  }}
}
